---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contacto - KU Soluciones | Desarrolladores Tecnológicos en Chile',
  description: 'Contacta con KU Soluciones para software a medida para pymes en Chile. Agenda una reunión gratuita o escríbenos por WhatsApp. Soporte local especializado.',
  keywords: 'contacto KU Soluciones, desarrolladores tecnológicos Chile, software pymes Chile, automatización procesos, consulta gratuita',
  canonical: 'https://www.ku-soluciones.cl/contact',
  openGraph: {
    type: 'website',
    locale: 'es_CL',
    url: 'https://www.ku-soluciones.cl/contact',
    siteName: 'KU Soluciones',
    title: 'Contacto - KU Soluciones | Desarrolladores Tecnológicos en Chile',
    description: 'Contacta con KU Soluciones para software a medida para pymes en Chile. Agenda una reunión gratuita.',
  },
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "name": "Contacto - KU Soluciones",
      "description": "Contacta con KU Soluciones para software a medida para pymes en Chile",
      "url": "https://www.ku-soluciones.cl/contact",
      "mainEntity": {
        "@type": "Organization",
        "name": "KU Soluciones",
        "telephone": "+56912345678",
        "email": "contacto@ku-soluciones.cl",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "CL",
          "addressRegion": "Región Metropolitana",
          "addressLocality": "Santiago"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+56912345678",
          "contactType": "customer service",
          "availableLanguage": ["Spanish"],
          "areaServed": "CL"
        }
      }
    }
  </script>

  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-8 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
          ¿Necesitas <span class="text-blue-600">desarrolladores tecnológicos</span> en Chile?
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Completa el formulario y nuestros especialistas en software a medida para pymes se pondrán en contacto en menos de 24 horas.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div class="bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-xl border border-gray-200 dark:border-slate-700">
          <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">Información de Contacto</h2>
          
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="bg-blue-100 dark:bg-blue-900 p-3 rounded-lg">
                <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-white">WhatsApp</h3>
                <p class="text-gray-600 dark:text-gray-300">+56 9 1234 5678</p>
                <a href="https://wa.me/56912345678" class="text-blue-600 hover:text-blue-700 dark:text-blue-400">Escribir mensaje</a>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="bg-green-100 dark:bg-green-900 p-3 rounded-lg">
                <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-white">Email</h3>
                <p class="text-gray-600 dark:text-gray-300">contacto@ku-soluciones.cl</p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="bg-purple-100 dark:bg-purple-900 p-3 rounded-lg">
                <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-white">Horario de Atención</h3>
                <p class="text-gray-600 dark:text-gray-300">Lunes a Viernes: 9:00 - 18:00</p>
                <p class="text-gray-600 dark:text-gray-300">Horario Chile (CLT)</p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="bg-orange-100 dark:bg-orange-900 p-3 rounded-lg">
                <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-white">Ubicación</h3>
                <p class="text-gray-600 dark:text-gray-300">Santiago, Chile</p>
                <p class="text-gray-600 dark:text-gray-300">Atendemos todo Chile</p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-slate-800 dark:to-slate-700 p-8 rounded-2xl">
          <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">¿Cómo podemos ayudarte?</h2>
          
          <div class="space-y-6">
            <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-slate-600">
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">📅 Agenda una reunión gratuita</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">Conversemos sobre tu proyecto y cómo podemos ayudarte a automatizar tus procesos.</p>
              <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors">
                Agendar reunión
              </button>
            </div>

            <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-slate-600">
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">💬 WhatsApp directo</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">¿Tienes una consulta rápida? Escríbenos por WhatsApp y te respondemos al instante.</p>
              <a href="https://wa.me/56912345678" class="block w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-center">
                Escribir por WhatsApp
              </a>
            </div>

            <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-slate-600">
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">✨ Tiempo de respuesta</h3>
              <p class="text-gray-600 dark:text-gray-300">
                <strong>Menos de 24 horas</strong> para responder tu consulta.<br>
                <strong>Consulta gratuita</strong> sin compromiso.<br>
                <strong>Soporte local</strong> en español.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
